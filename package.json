{
  "name": "qa-regression-manager",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "QA Regression Manager - Web application and API for regression test management",
  "scripts": {
    "build": "nx run-many -t build",
    "build:api": "nx build api",
    "build:web": "nx build web",
    "serve": "nx run-many -t serve --parallel",
    "serve:api": "nx serve api",
    "serve:web": "nx serve web",
    "dev": "nx run-many -t serve --parallel --projects=api,web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "nx run api:typeorm:migrate",
    "lint:docs": "echo \"linting docs (hook up markdownlint or similar if desired)\""
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@nestjs/cli": "^11.0.16",
    "@nx/devkit": "19.8.4",
    "@nx/eslint-plugin": "^22.5.3",
    "@nx/jest": "19.8.4",
    "@nx/js": "19.8.4",
    "@nx/nest": "^19.8.4",
    "@nx/next": "^19.8.4",
    "@nx/playwright": "19.8.4",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/react": "15.0.6",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "18.16.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "babel-jest": "^29.7.0",
    "eslint-config-next": "14.2.3",
    "eslint-plugin-import": "2.30.0",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nx": "^19.8.4",
    "prettier": "^2.6.2",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typescript": "~5.5.2",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
