  "scripts": {
    "db:up": "docker compose up db -d",
    "db:down": "docker compose down",
    "dev": "docker compose up db -d && npm run typeorm:run && concurrently \"npx nx serve api\" \"npx nx dev regression-ui-regression-ui\"",
    "dev:legacy": "npm run typeorm:run && concurrently \"npx nx serve api\" \"ng serve -o\"",
    "docker:up": "docker compose --profile full up --build",
    "docker:down": "docker compose --profile full down",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js --config apps/api/src/app/ormconfig.ts",
    "typeorm:migrate": "npm run typeorm migration:generate -- -n",
    "typeorm:run": "npm run typeorm migration:run",
    "ng": "ng",
    "nx": "nx",
    "start": "npm run typeorm:run && node dist/apps/api/main.js",
    "build": "npx nx build api --prod",
    "test": "ng test",
    "lint": "nx workspace-lint && ng lint",
    "e2e": "ng e2e",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "update": "ng update @nrwl/workspace",
    "update:check": "ng update",
    "workspace-schematic": "nx workspace-schematic",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "postinstall": "echo postinstall complete"
